<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<key>CFBundleDisplayName</key>
	<string>TappyAI</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>

	<!-- Environment (injected from Config/*.xcconfig) -->
	<key>TAPPY_API_BASE_URL</key>
	<string>$(TAPPY_API_BASE_URL)</string>
	<key>TAPPY_ENV</key>
	<string>$(TAPPY_ENV)</string>
	<key>SUPABASE_URL</key>
	<string>$(SUPABASE_URL)</string>
	<key>SUPABASE_ANON_KEY</key>
	<string>$(SUPABASE_ANON_KEY)</string>

	<!-- Launch + orientation -->
	<key>UILaunchScreen</key>
	<dict/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>

	<!-- Permission usage strings (foundation placeholders; wording finalized with feature work) -->
	<key>NSCameraUsageDescription</key>
	<string>TappyAI uses the camera to take photos and record videos for your posts, and to scan menus, receipts and QR codes. Photos are only used when you post or scan.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>TappyAI uses the microphone for voice input in chat and to record the sound of videos you post.</string>
	<!-- Required by App Store processing (ITMS-90683): chat voice input uses SFSpeechRecognizer
	     (Features/Chat/Data/VoiceInputManager.swift). Build 16 was rejected without it. -->
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>TappyAI turns what you say into a chat message. Your voice is transcribed by Apple speech recognition and is not stored by TappyAI.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>TappyAI reads the photos and videos you choose to post, set as your avatar or cover, or send to be scanned. Nothing else in your library is read.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>TappyAI saves the share cards and images you choose to save to your photos.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>TappyAI uses your precise location, only while the app is open and only if you allow it, to find places around you. It is never used in the background.</string>

	<!-- Custom URL scheme for OAuth callbacks (Google/Zalo). Also register a universal-link domain (D4). -->
	<!-- Share sheet (Core/Share/TappyShare.appScheme): canOpenURL answers false for any scheme
	     not listed here, so this must stay identical to TappyShare.queriedSchemes. -->
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>fb-messenger</string>
		<string>zalo</string>
		<string>whatsapp</string>
		<string>tg</string>
		<string>viber</string>
		<string>line</string>
	</array>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>com.tappyai.ios</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>tappyai</string>
			</array>
		</dict>
	</array>

	<!-- App Transport Security: allow plain HTTP to localhost for Debug simulator builds.
	     Debug.xcconfig sets TAPPY_API_BASE_URL = http://localhost:3000 (HTTP). Without this
	     exception, URLSession blocks all connections and the app cannot reach the backend in
	     development. Production builds use HTTPS so this exception has no effect in release.
	     Apple explicitly permits localhost ATS exceptions during App Store review. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSExceptionDomains</key>
		<dict>
			<key>localhost</key>
			<dict>
				<key>NSExceptionAllowsInsecureHTTPLoads</key>
				<true/>
			</dict>
		</dict>
	</dict>
</dict>
</plist>
