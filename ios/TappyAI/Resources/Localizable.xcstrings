    "copyright.heading": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Music copyright policy (Original Sound)"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chính sách bản quyền âm nhạc (Original Sound)"
          }
        }
      }
    },
    "copyright.s1.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When you upload a track (an “Original Sound”), you confirm that you own it or hold every legal right to it, and you grant TappyAI and other users the right to use it on the platform (adding it to videos, playing it back). You may not upload music owned by someone else without permission."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi đăng một bản nhạc (“Original Sound”), bạn cam kết rằng bạn sở hữu hoặc có đầy đủ quyền hợp pháp đối với bản nhạc đó, và cấp cho TappyAI cùng người dùng khác quyền sử dụng nó (chèn vào video, phát lại) trên nền tảng. Bạn không được đăng nhạc có bản quyền của người khác khi chưa được phép."
          }
        }
      }
    },
    "copyright.s1.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "1. Conditions for uploading music"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "1. Điều kiện khi đăng nhạc"
          }
        }
      }
    },
    "copyright.s2.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Whoever uploads a track is legally responsible for it. TappyAI acts as an intermediary platform and will remove infringing content on receiving a valid notice."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Người đăng chịu trách nhiệm pháp lý về nội dung mình tải lên. TappyAI hoạt động như một nền tảng trung gian và sẽ gỡ bỏ nội dung vi phạm khi nhận được thông báo hợp lệ."
          }
        }
      }
    },
    "copyright.s2.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "2. Responsibility"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "2. Trách nhiệm"
          }
        }
      }
    },
    "copyright.s3.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If you hold the rights to a work and believe a track on TappyAI infringes them, send a notice to the copyright agent below, or use the “Report” button on the track’s page. Your notice needs: (a) the track or link that infringes, (b) evidence that you are the rights holder, (c) your contact details."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nếu bạn là chủ sở hữu quyền và cho rằng một bản nhạc trên TappyAI vi phạm bản quyền của bạn, hãy gửi thông báo tới đại diện bản quyền bên dưới, hoặc dùng nút “Báo cáo” trên trang bài nhạc. Thông báo cần gồm: (a) bản nhạc/đường dẫn bị vi phạm, (b) bằng chứng bạn là chủ sở hữu, (c) thông tin liên hệ."
          }
        }
      }
    },
    "copyright.s3.sla": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We review valid notices and remove infringing content within 24–48 hours of receiving them."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chúng tôi sẽ xem xét và gỡ bỏ nội dung vi phạm trong vòng 24–48 giờ kể từ khi nhận được thông báo hợp lệ."
          }
        }
      }
    },
    "copyright.s3.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "3. Reporting infringement (notice and takedown)"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "3. Báo cáo vi phạm (Notice-and-Takedown)"
          }
        }
      }
    },
    "copyright.s4.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We receive and handle every copyright complaint at this address:"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chúng tôi tiếp nhận và xử lý mọi khiếu nại bản quyền qua địa chỉ này:"
          }
        }
      }
    },
    "copyright.s4.emailAccessibility": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Email the copyright agent"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Gửi email cho đại diện bản quyền"
          }
        }
      }
    },
    "copyright.s4.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "4. Copyright agent"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "4. Đại diện bản quyền"
          }
        }
      }
    },
    "copyright.s5.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An account that repeatedly uploads infringing content may lose the ability to upload music, or be suspended."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tài khoản nhiều lần đăng nội dung vi phạm bản quyền có thể bị hạn chế đăng nhạc hoặc khóa."
          }
        }
      }
    },
    "copyright.s5.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "5. Repeat infringement"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "5. Xử lý vi phạm lặp lại"
          }
        }
