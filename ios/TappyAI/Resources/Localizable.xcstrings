    "ugc.terms.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To post reviews and comments on TappyAI, you agree to the Terms of Service. TappyAI has no tolerance for objectionable content or abusive users."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Để đăng review và bình luận trên TappyAI, bạn đồng ý với Điều khoản sử dụng. TappyAI không chấp nhận nội dung phản cảm hay người dùng có hành vi lạm dụng."
          }
        }
      }
    },
    "ugc.terms.readFull": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
