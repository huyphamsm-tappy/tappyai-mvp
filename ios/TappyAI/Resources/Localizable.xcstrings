        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đọc toàn bộ Điều khoản sử dụng"
          }
        }
      }
    },
    "ugc.terms.rule1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No hateful, violent, sexual, harassing or illegal content, and nothing that infringes others' rights."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không đăng nội dung thù ghét, bạo lực, khiêu dâm, quấy rối, vi phạm pháp luật hoặc xâm phạm quyền của người khác."
          }
        }
      }
    },
    "ugc.terms.rule2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Anyone can report a post or comment; reports are reviewed and violating content is removed."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ai cũng có thể báo cáo bài đăng hoặc bình luận; báo cáo được xem xét và nội dung vi phạm sẽ bị gỡ."
          }
        }
      }
    },
    "ugc.terms.rule3": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Accounts that break these rules may be restricted or removed."
