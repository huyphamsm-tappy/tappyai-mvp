# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# Anthropic
ANTHROPIC_API_KEY=sk-ant-api03-...

# App URL (dùng cho Supabase redirect)
NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app

# Travelpayouts / Aviasales — dùng cho tính năng tra giá vé máy bay
# Lấy token tại: https://www.travelpayouts.com/developers/api (đăng nhập → API → Token)
TRAVELPAYOUTS_TOKEN=your_travelpayouts_token_here

# Apple In-App Purchase (App Store Server API + Notifications V2)
# Required before enabling SHOW_PRO_UPGRADE.
# App Store Connect → Users and Access → Integrations → In-App Purchase
APPLE_IAP_ISSUER_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
APPLE_IAP_KEY_ID=XXXXXXXXXX
# Paste the full .p8 private key content; escape newlines as \n for Vercel env vars
APPLE_IAP_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nMIGH...\n-----END PRIVATE KEY-----
APPLE_IAP_BUNDLE_ID=com.tappyai.ios
# "Sandbox" during development/TestFlight, "Production" in the App Store
APPLE_IAP_ENV=Production
# OPTIONAL. Apple Root CA - G3 is pinned in code (src/lib/apple-iap/jws.ts) and is always trusted;
# this only ADDS another root (e.g. a future Apple root) without a deploy. Leave unset normally.
# Format if used: PEM of the root certificate, newlines escaped as \n.
# APPLE_ROOT_CA_PEM=-----BEGIN CERTIFICATE-----\nMIIC...\n-----END CERTIFICATE-----

# In-app account deletion (POST /api/account/delete). Set to true per environment ONLY after the data clean-up behind it is live there.
ACCOUNT_SELF_DELETE_ENABLED=
# Sign in with Apple token revocation at account deletion (App Review 5.1.1(v)). Names only; values are secrets and never go in git.
#   Team ID and Key ID are 10 characters; the key is the .p8 of a key with "Sign in with Apple" enabled; a literal backslash-n is accepted.
#   Client id defaults to the iOS bundle id. Unset/invalid -> an Apple account cannot be deleted (503), never deleted unrevoked.
APPLE_SIWA_TEAM_ID=
APPLE_SIWA_KEY_ID=
APPLE_SIWA_PRIVATE_KEY=
APPLE_SIWA_CLIENT_ID=
