# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# Anthropic
ANTHROPIC_API_KEY=sk-ant-api03-...

# App URL (dùng cho Supabase redirect)
NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app

# Google Analytics 4 (web) — OPTIONAL. Bỏ trống ở local/preview; chỉ đặt cho Production trên Vercel.
# Khi trống: không tải gtag.js, không gửi gì. Xem docs/analytics/GA4_SETUP.md
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Travelpayouts / Aviasales — dùng cho tính năng tra giá vé máy bay
# Lấy token tại: https://www.travelpayouts.com/developers/api (đăng nhập → API → Token)
TRAVELPAYOUTS_TOKEN=your_travelpayouts_token_here

# Apple In-App Purchase (App Store Server API + Notifications V2)
# Required before enabling SHOW_PRO_UPGRADE.
# App Store Connect → Users and Access → Integrations → In-App Purchase
APPLE_IAP_ISSUER_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
APPLE_IAP_KEY_ID=XXXXXXXXXX
# Paste the full .p8 private key content; escape newlines as \n for Vercel env vars
APPLE_IAP_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nMIGH...\n-----END PRIVATE KEY-----
APPLE_IAP_BUNDLE_ID=com.tappyai.ios
# "Sandbox" during development/TestFlight, "Production" in the App Store
APPLE_IAP_ENV=Production
# OPTIONAL. Apple Root CA - G3 is pinned in code (src/lib/apple-iap/jws.ts) and is always trusted;
# this only ADDS another root (e.g. a future Apple root) without a deploy. Leave unset normally.
# Format if used: PEM of the root certificate, newlines escaped as \n.
# APPLE_ROOT_CA_PEM=-----BEGIN CERTIFICATE-----\nMIIC...\n-----END CERTIFICATE-----

# ── Free acquisition (G1) — all optional; every feature below is OFF until set ────────────────
# IndexNow: push new LISTED public pages to Bing/Yandex/Naver/Seznam/Yep. Generate your own
# 8–128 hex chars (e.g. `openssl rand -hex 16`). Served at /.well-known/indexnow/<KEY>.txt.
# NEVER commit a real key. Leave empty in non-production.
INDEXNOW_KEY=
# Official profiles for Organization JSON-LD `sameAs` — comma-separated https URLs of profiles
# TappyAI actually owns (LinkedIn company page, Crunchbase, GitHub org, …). Never a guess.
ORGANIZATION_SAME_AS=
# Browser-extension store listing URLs — set ONLY after the listing is live; the /extension page
# shows install buttons only for configured stores, and only on the real store hosts.
NEXT_PUBLIC_EXTENSION_URL_CHROME=
NEXT_PUBLIC_EXTENSION_URL_EDGE=
NEXT_PUBLIC_EXTENSION_URL_FIREFOX=
# Android App Links: comma-separated SHA-256 fingerprints of the RELEASE signing certificate(s)
# (Play Console → App integrity → App signing key certificate). /.well-known/assetlinks.json
# is 404 until set. Pair with -PTAPPYAI_APP_LINKS_ENABLED=true on the Android build.
ANDROID_APP_LINKS_SHA256=
# iOS Universal Links: <TEAMID>.<bundle id>. /.well-known/apple-app-site-association is 404 until set.
IOS_UNIVERSAL_LINKS_APP_ID=

# In-app self-service account deletion (/profile/settings/delete-account).
# Set to true ONLY where migrations D1/D2/D4 (DEPLOY-CHECKLIST) are applied. Off = request-by-email.
ACCOUNT_SELF_DELETE_ENABLED=false

# Affiliate (docs/commerce/AFFILIATE_STATUS.md). Publisher id is PUBLIC (it is in every tracked link);
# unset ⇒ every commerce link is direct. CCP_ATTRIBUTION_SECRET keys the pseudonymous sub1 (≥32 random
# chars, different per environment); unset ⇒ links are tracked but not attributable to a Tappy identity.
ACCESSTRADE_PUBLISHER_ID=
CCP_ATTRIBUTION_SECRET=
