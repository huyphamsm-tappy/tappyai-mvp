	    FROM pg_index i
	   WHERE i.indrelid = 'public.user_memory'::regclass
	     AND i.indisunique
	     AND i.indnatts = 1
	     AND i.indkey[0] = (SELECT attnum FROM pg_attribute
	                         WHERE attrelid = 'public.user_memory'::regclass AND attname = 'user_id');
