+    /// V1 supports YouTube only (product decision 2026-07-26). TikTok/Facebook/Instagram
+    /// are unsupported for import, so their URLs are not recognized. The enum keeps the
+    /// `tiktok`/`facebook` cases purely so legacy posts still decode and render gracefully.
     static func detect(url: String) -> ExternalSource? {
         let lower = url.lowercased()
         if lower.contains("youtube.com") || lower.contains("youtu.be") { return .youtube }
-        if lower.contains("tiktok.com") { return .tiktok }
-        if lower.contains("facebook.com") || lower.contains("fb.com") || lower.contains("fb.watch") { return .facebook }
         return nil
     }
 
