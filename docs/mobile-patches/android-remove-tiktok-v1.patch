+    /**
+     * Provider detection — mirrors the web's `detectSource`. V1 supports YouTube only
+     * (product decision 2026-07-26); TikTok/Facebook/Instagram are unsupported, so their
+     * URLs are not recognized and cannot be attached.
+     *
+     * The supported set is gated by [supportedLinkProviders], which SHOULD be populated
+     * from GET /api/config `video.linkProviders` (the backend-owned single source shared
+     * with web + iOS) rather than hardcoded — see the class doc / migration note. Until
+     * that wiring lands it falls back to the V1 default of YouTube only.
+     */
+    private fun detectSource(url: String): String? {
+        val provider = when {
+            url.contains("youtube.com") || url.contains("youtu.be") -> "youtube"
+            else -> return null
+        }
+        return if (provider in supportedLinkProviders) provider else null
     }
 
