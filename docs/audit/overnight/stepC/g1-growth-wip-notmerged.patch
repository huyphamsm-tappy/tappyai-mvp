+                      target="_blank"
+                      rel="noopener noreferrer nofollow"
+                      data-cta-type={a.kind}
+                      className="rounded-lg border border-gray-200 dark:border-gray-700 px-2.5 py-1 text-xs font-medium"
+                    >
+                      {a.platform ?? (locale === 'en' ? a.kind : a.kind)}
+                    </a>
+                  ))}
+                </div>
+              )}
+            </div>
+          </div>
