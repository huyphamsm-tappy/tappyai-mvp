link\":\"\"},{\"time\":\"11:30\",\"emoji\":\"🍜\",\"category\":\"food\",\"name\":\"MẸT Hội An - Vietnamese cuisine & Vegetarian options 7\",\"description\":\"Nhà hàng Việt Nam chất lượng cao với 4.9⭐ (14.145 đánh giá). Mở 10:00–22:30, giá 100-300k/người, có món chay.\",\"price\":\"chưa có giá\",\"address\":\"49 Nguyễn Thái Học, Old Town, Hội An\",\"maps_link\":\"https://maps.google.com/?cid=8609020210729391502\",\"booking_link\":\"https://metvietnameserestaurant.com/\"},{\"time\":\"13:30\",\"emoji\":\"🚣\",\"category\":\"attraction\",\"name\":\"Bay Mau Coconut Forest Tour\",\"description\":\"Tour thuyền qua rừng dừa xinh đẹp, 4.7⭐ (1.957 đánh giá). Mở 09:00–17:00, trải nghiệm độc đáo của Hội An.\",\"price\":\"chưa có giá\",\"add"}
