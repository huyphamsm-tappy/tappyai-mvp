<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base application theme — content is rendered entirely in Compose (core:designsystem Theme.kt).
         This XML theme only controls the pre-Compose window background/splash. -->
    <style name="Theme.TappyAI" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@android:color/white</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- Cold-start splash (androidx.core.splashscreen) — MainActivity's manifest theme; installed
         via SplashScreen.installSplashScreen() before setContent, then handed off to
         Theme.TappyAI for everything after. Reuses the existing launcher icon, not new art (Tappy
         mascot art is owner-authored only, see project convention — no new splash-specific asset
         invented here). -->
    <style name="Theme.TappyAI.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@android:color/white</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="postSplashScreenTheme">@style/Theme.TappyAI</item>
    </style>
</resources>
